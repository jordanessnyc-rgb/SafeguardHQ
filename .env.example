# Names only — real values live in Vercel / Railway secret stores (CLAUDE.md rule 3).

# Postgres (Supabase). App + worker use the pooled URL; migrations use the direct/session URL.
DATABASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=              # server-only: owner invites

# Public origin used in auth emails/redirects, e.g. https://crm.ess-nyc.com
NEXT_PUBLIC_SITE_URL=

# AIRnyc member-field encryption: `openssl rand -base64 32`. Losing it = losing member data.
AIRNYC_ENCRYPTION_KEY=

# NYC Open Data (Socrata) app token — avoids shared-pool throttling
SOCRATA_APP_TOKEN=

# Google Drive — set ONE of:
GOOGLE_SERVICE_ACCOUNT_JSON=      # service account (folders must be in a Shared Drive)
GOOGLE_OAUTH_CLIENT_ID=           # …or OAuth for Jordan's account
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Tests only: throwaway Postgres (scripts/test-db.sh sets this)
TEST_DATABASE_URL=
