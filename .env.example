# Names only — real values live in Vercel / Railway secret stores (CLAUDE.md rule 3).

# Postgres (Supabase). App + worker use the pooled URL; migrations use the direct/session URL.
DATABASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=              # server-only: owner invites

# Public origin used in auth emails/redirects, e.g. https://crm.ess-nyc.com
NEXT_PUBLIC_SITE_URL=

# AIRnyc member-field encryption: `openssl rand -base64 32`. Losing it = losing member data.
AIRNYC_ENCRYPTION_KEY=

# NYC Open Data (Socrata) app token — avoids shared-pool throttling
SOCRATA_APP_TOKEN=

# Google Drive — set ONE of:
GOOGLE_SERVICE_ACCOUNT_JSON=      # service account (folders must be in a Shared Drive)
GOOGLE_OAUTH_CLIENT_ID=           # …or OAuth for Jordan's account
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_EXPORT_FOLDER_ID=    # weekly CSV export of all tables (keep this folder owner-only)

# --- Phase 2: communications -----------------------------------------------------------
# Quo (Workspace Settings → API). Webhook secret is the `key` (whsec_…) returned by POST /webhooks.
QUO_API_KEY=
QUO_WEBHOOK_SECRET=

# Titan — dedicated crm@ mailbox with "Enable Titan on Other Apps" (use an app password if 2FA is on)
TITAN_USER=
TITAN_PASSWORD=
TITAN_IMAP_HOST=                  # default imap.titan.email (EU accounts differ — see RUNBOOK)
TITAN_IMAP_PORT=                  # default 993
TITAN_SMTP_HOST=                  # default smtp.titan.email
TITAN_SMTP_PORT=                  # default 465 (implicit TLS); 587 = STARTTLS
TITAN_SMTP_SECURE=                # optional override: true = implicit TLS, false = STARTTLS
TITAN_SENT_FOLDER=                # default Sent
MAIL_APPEND_TO_SENT=              # default true; set false if Titan already files SMTP sends in Sent

# Anthropic (AI triage). Model names are config, not code:
ANTHROPIC_API_KEY=
AI_MODEL_CLASSIFY=                # default claude-haiku-4-5
AI_MODEL_DRAFT=                   # default claude-sonnet-5
AI_MODEL_REPORT=                  # default claude-opus-5
REVIEW_URL=                       # link used by the review-request SMS template

# --- Phase 5: website lead form (/api/leads) ----------------------------------------------
LEADS_ALLOWED_ORIGINS=            # default https://ess-nyc.com,https://www.ess-nyc.com
LEADS_API_KEY=                    # optional: server-to-server form builders send it as X-Lead-Key

# --- Phase 4: Titan calendar (CalDAV) — worker only ----------------------------------------
TITAN_CALDAV_ENABLED=             # true to copy scheduled inspections to the Titan calendar
TITAN_CALDAV_URL=                 # default https://dav.titan.email/principals/ (EU: dav-eu.titan.email; GoDaddy: dav.myprofessionalmail.com)
TITAN_CALDAV_USERNAME=            # default TITAN_USER
TITAN_CALDAV_PASSWORD=            # default TITAN_PASSWORD (app password if 2FA is on)
TITAN_CALDAV_CALENDAR_URL=        # optional: pin the collection, e.g. https://dav.titan.email/principals/<email>/calendar/<id>/
TITAN_CALDAV_CALENDAR_NAME=       # optional: pick a calendar by display name when discovering

# --- Phase 4: DocuSign (JWT Grant) — Vercel + worker -----------------------------------
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=                 # the sending user's GUID (Apps and Keys page)
DOCUSIGN_PRIVATE_KEY=             # RSA private key PEM (\n-escaped is fine)
DOCUSIGN_ENV=                     # demo (default) | production (after DocuSign Go-Live review)
DOCUSIGN_ACCOUNT_ID=              # optional: pick the account if the user has several
DOCUSIGN_HMAC_KEYS=               # Connect HMAC secret(s), comma-separated (eSignature Admin → Connect Keys)

# --- Phase 3: FreshBooks ---------------------------------------------------------------
# App at my.freshbooks.com/#/developer. Redirect URI must be HTTPS: https://<crm>/api/freshbooks/callback
FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=
FRESHBOOKS_REDIRECT_URI=
FRESHBOOKS_SCOPES=                 # optional; empty = the scopes ticked on the FreshBooks app

# Local testing only (never set in production; ignored when NODE_ENV=production):
FRESHBOOKS_API_BASE=              # point FreshBooks API calls at a mock server
FRESHBOOKS_AUTH_BASE=
MAIL_ALLOW_SELF_SIGNED_FOR_LOCAL_TESTING=
QUO_API_BASE=                     # point Quo calls at a mock server

# Tests only: throwaway Postgres (scripts/test-db.sh sets this)
TEST_DATABASE_URL=

# Error tracking (Sentry) — optional; everything is off while these are empty
SENTRY_DSN=                       # server + worker
NEXT_PUBLIC_SENTRY_DSN=           # browser (same DSN)
SENTRY_ORG=                       # only for source-map upload at build time
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
